NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://booking_system:booking_system@localhost:5434/booking_system
REDIS_URL=redis://localhost:6381

KAFKA_BROKERS=localhost:29093
KAFKA_CLIENT_ID=booking-system-backend
KAFKA_CDC_GROUP_ID=booking-system-cdc-consumer
KAFKA_CDC_TOPIC=booking-system.public.seats

# Trust boundary (ticket 0002): addresses of the one trusted proxy hop
# (lb-proxy) whose X-Forwarded-For values the rate limiter's request.ip
# may be derived from. Defaults to "loopback" (dev: lb-proxy and backend
# both on the host); in-cluster set this to the k8s pod CIDR.
TRUST_PROXY_ADDRESSES=loopback

# Per-client rate limit. Raise RATE_LIMIT_MAX_REQUESTS for a load-test run
# (all local traffic shares one IP) -- leave at the default for real deploys.
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Local JWT auth (ADR 0002). Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Origins allowed to call this API cross-origin (comma-separated). Default
# matches Vite's default dev port.
CORS_ORIGINS=http://localhost:5173
